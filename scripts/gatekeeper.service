# Gatekeeper systemd service

[Unit]

# Describe the Gatekeeper IPS service
Description=Gatekeeper IPS - Hybrid AI XGBoost + eBPF/XDP DDoS Enforcer

# Start after the network is ready
After=network-online.target
Wants=network-online.target


[Service]

# Run Gatekeeper as a foreground process
Type=simple


# Set the project working directory
# TODO: Change to your own path
WorkingDirectory=/home/hoangminh13022006/ML-DDoS


# Start the Gatekeeper service
# TODO: Change to your own path
ExecStart=/home/hoangminh13022006/ML-DDoS/scripts/start_ips.sh


# Run as root because eBPF/XDP and BPF map access require it
User=root
Group=root


# Set environment variables
# Never commit Telegram tokens or chat IDs to Git
Environment=GW_INTERFACE=ens4
Environment=TG_BOT_TOKEN=
Environment=TG_CHAT_ID=
Environment=GCS_BUCKET_NAME=


# Restart the service when it crashes
# Limit retries to avoid infinite restart loops
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=300
StartLimitBurst=5


# Allow enough time for a clean shutdown
# gatekeeper.py already calls enforcer.detach() in finally
TimeoutStopSec=15


[Install]

# Start the service during normal multi-user boot
WantedBy=multi-user.target