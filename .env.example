# Mẫu tệp cấu hình biến môi trường (Copy file này thành .env trên máy chủ)

GW_INTERFACE=ens4

# ── WHITELIST ────────────────────────────────────────────────────────────────
# Các dải IP KHÔNG BAO GIỜ bị chặn, ngăn cách bởi dấu phẩy.
# Đặt IP văn phòng / VPN / máy quản trị của bạn vào đây.
#
# Các dải hạ tầng bắt buộc (IAP 35.235.240.0/20, metadata 169.254.169.254/32,
# health check của GCP) đã được nạp sẵn trong code, không cần khai lại.
WHITELIST_CIDRS=

# CẢNH BÁO: đặt =1 sẽ nạp toàn bộ dải IP của GCP (cloud.json) và Fastly vào
# whitelist. Đó là dải KHÁCH HÀNG — bất kỳ ai thuê một con VM GCP đều trở nên
# miễn nhiễm với IPS. Chỉ bật khi server chỉ nhận traffic qua CDN.
WHITELIST_BULK_CLOUD=0

# Whitelist Canonical/Ubuntu bằng cách phân giải DNS lúc khởi động.
# Mặc định TẮT: apt là kết nối do máy chủ khởi tạo nên không bao giờ bị chặn,
# mà whitelist theo DNS thì ai chi phối được resolver sẽ tự đưa IP của mình
# vào danh sách miễn nhiễm.
WHITELIST_CANONICAL=0

# ── NGƯỠNG VOLUMETRIC TOÀN CỤC ───────────────────────────────────────────────
# Cộng dồn trên MỌI source trong cửa sổ 5 giây. Đây là tuyến duy nhất phát hiện
# được flood phân tán / giả mạo source, vì loại đó không có IP nào nổi bật.
GLOBAL_SYN_THRESHOLD=2000
GLOBAL_PACKET_THRESHOLD=20000
GLOBAL_SOURCE_THRESHOLD=500
FLOOD_MODE_DIVISOR=10

# ── Cấu hình Telegram Alert ──────────────────────────────────────────────────
TG_BOT_TOKEN=
TG_CHAT_ID=

# Chu kỳ gửi báo cáo tổng hợp (giây) và số chu kỳ yên ắng trước khi báo hết bão
TG_DIGEST_INTERVAL_S=60
TG_IDLE_CYCLES=2

# ── Cấu hình Google Cloud Storage ────────────────────────────────────────────
GCS_BUCKET_NAME=
GCS_LOG_PREFIX=ddos-logs/
GCS_FLUSH_INTERVAL=300

# ── SOC DASHBOARD (Cloud Run) ────────────────────────────────────────────────
# Bắt buộc, trừ khi đã đặt Cloud IAP phía trước và bật ALLOW_ANONYMOUS.
DASHBOARD_PASSWORD=
DASHBOARD_ALLOW_ANONYMOUS=0
DASHBOARD_MAX_LOG_FILES=50
DASHBOARD_REFRESH_S=10
